<?xml version="1.0" encoding="UTF-8"?>
<project xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd" xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <!-- This module was also published with a richer model, Gradle metadata,  -->
  <!-- which should be used instead. Do not delete the following line which  -->
  <!-- is to indicate to Gradle or any Gradle module metadata file consumer  -->
  <!-- that they should prefer consuming it instead. -->
  <!-- do_not_remove: published-with-gradle-metadata -->
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.michaelgrundvig.frc</groupId>
  <artifactId>spotter-manager</artifactId>
  <version>0.4.2</version>
  <name>spotter-manager</name>
  <description>Spotter's manager, for an FRC robot program: each coprocessor agent's stream kept open off the robot loop, its values judged against their limits, alerts as data, a snapshot to read each loop; and Spotter's protocol, version 2 (spotter.proto, generated by QuickBuffers).</description>
  <url>https://github.com/mikegrundvig/frc-spotter</url>
  <licenses>
    <license>
      <name>MIT License</name>
      <url>https://github.com/mikegrundvig/frc-spotter/blob/main/LICENSE</url>
    </license>
  </licenses>
  <developers>
    <developer>
      <name>Michael Grundvig</name>
      <url>https://github.com/mikegrundvig</url>
    </developer>
  </developers>
  <scm>
    <connection>scm:git:https://github.com/mikegrundvig/frc-spotter.git</connection>
    <url>https://github.com/mikegrundvig/frc-spotter</url>
  </scm>
  <dependencies>
    <dependency>
      <groupId>us.hebi.quickbuf</groupId>
      <artifactId>quickbuf-runtime</artifactId>
      <version>1.4</version>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <groupId>org.jspecify</groupId>
      <artifactId>jspecify</artifactId>
      <version>1.0.1</version>
      <scope>compile</scope>
    </dependency>
  </dependencies>
</project>
