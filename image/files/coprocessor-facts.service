[Unit]
Description=Write the drive's health and the SPI bootloader's version for the health agent
Before=coprocessor-agent.service

[Service]
Type=oneshot
ExecStart=/usr/local/lib/coprocessor/coprocessor-facts.sh
Nice=10
AllowedCPUs=0-3
# It runs as root only to read two devices; everything else is closed: no network, the file
# system read-only but /run/coprocessor, which outlives each run so the agent can read it, and no
# device but those two, read-only. (nvme-cli's health query needs CAP_SYS_ADMIN.) To check on a
# board: the files appear in /run/coprocessor.
RuntimeDirectory=coprocessor
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateNetwork=yes
NoNewPrivileges=yes
DevicePolicy=closed
DeviceAllow=/dev/nvme0 r
DeviceAllow=/dev/mtd0 r
CapabilityBoundingSet=CAP_SYS_ADMIN
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
LockPersonality=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
