[Unit]
Description=Make this drive's SSH host key on /data
RequiresMountsFor=/data
Before=ssh.service ssh.socket
ConditionPathExists=!/data/ssh/ssh_host_ed25519_key

[Service]
Type=oneshot
# Made under a temporary name and moved into place, so a power cut never leaves half a key where
# sshd looks: the key appears whole, or not at all and the next boot makes it again.
ExecStart=/usr/bin/install -d -m 0700 /data/ssh
ExecStart=/usr/bin/rm -f /data/ssh/ssh_host_ed25519_key.new /data/ssh/ssh_host_ed25519_key.new.pub
ExecStart=/usr/bin/ssh-keygen -q -t ed25519 -N "" -C "" -f /data/ssh/ssh_host_ed25519_key.new
ExecStart=/usr/bin/sync /data/ssh/ssh_host_ed25519_key.new /data/ssh/ssh_host_ed25519_key.new.pub
ExecStart=/usr/bin/mv -f /data/ssh/ssh_host_ed25519_key.new.pub /data/ssh/ssh_host_ed25519_key.pub
ExecStart=/usr/bin/mv -f /data/ssh/ssh_host_ed25519_key.new /data/ssh/ssh_host_ed25519_key
ExecStart=/usr/bin/sync /data/ssh

[Install]
WantedBy=ssh.service ssh.socket
