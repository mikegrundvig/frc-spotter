# shellcheck shell=bash disable=SC2034 # the scripts that source this use its values
# Orange Pi 5B: the board's facts the image scripts need. Sourced by provision.sh, layout.sh, and
# plan.sh.
#
# RK3588S. Soldered eMMC, 32-256 GB; no SPI flash listed; no M.2 slot. The image
# goes on the eMMC, so the spare boot medium is a spare board.

# Verified in PhotonVision's own workflows (photonvision's build.yml, photon-image-modifier's
# main.yml): the base image's name, where its root is, its headroom, and the smoke test's platform.
BOARD_TITLE="Orange Pi 5B"
BOARD_PV_ASSET=photonvision_opi5b.img.xz  # the base image, a photon-image-modifier release asset
BOARD_ROOT_LOCATION=partition=1  # where photon-image-runner finds the root
BOARD_MINIMUM_FREE_MB=1024       # root headroom before provisioning
BOARD_PV_PLATFORM=LINUX_RK3588_64  # PhotonVision's --platform for the smoke test

# Waiting on the board model: from Orange Pi's product page and Armbian's defaults, not yet tried
# on a board. README.md ("What's unverified") lists the bench check that settles each.
BOARD_VERIFIED=no
BOARD_BOOT_MEDIUM=emmc  # what the image is written to: nvme (an M.2 drive) or emmc (soldered)
BOARD_SPI_FLASH=no  # yes when the bootloader can live in SPI flash, so the board boots NVMe
BOARD_BOOT_PATH=/boot/boot.scr  # what U-Boot runs: Armbian's boot script, in the root partition
BOARD_ROOT_PARTITION=1          # the root; layout.sh adds COPROC and data after it
