# PhotonVision as its image runs it (PhotonVision's own unit, with -n, as the image builder's
# drop-in adds), on the Java its image carries.
[Unit]
Description=Service that runs PhotonVision
RequiresMountsFor=/data

[Service]
WorkingDirectory=/opt/photonvision
Nice=-10
ExecStart=/opt/photonvision/jre/bin/java -Xmx512m -jar /opt/photonvision/photonvision.jar -n
ExecStop=/bin/systemctl kill photonvision
Type=simple
Restart=on-failure
RestartSec=1
TimeoutStopSec=15s

[Install]
WantedBy=multi-user.target
