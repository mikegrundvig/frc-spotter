// PhotonVision's pack (coprocessor/README.md, "Packs"): the agent's account may stop PhotonVision's
// unit (its step before a power-off, so its settings are saved) and restart it; polkit refuses it
// everything else this rule doesn't name. The agent package's own rule lets it power off.
polkit.addRule(function (action, subject) {
  if (subject.user !== "frc-coprocessor-agent") {
    return polkit.Result.NOT_HANDLED;
  }
  if (action.id === "org.freedesktop.systemd1.manage-units" &&
      action.lookup("unit") === "photonvision.service" &&
      (action.lookup("verb") === "stop" || action.lookup("verb") === "restart")) {
    return polkit.Result.YES;
  }
  return polkit.Result.NOT_HANDLED;
});
