# The coprocessor agent (docs/agent.md): the web service that speaks protocol 2 to the robot's
# manager, running what its packs declare (folders in /etc/frc-spotter/packs/), on 5808 unless
# /etc/frc-spotter/agent.json says otherwise. Installed by its package as
# /usr/lib/systemd/system/frc-spotter.service.
#
# It stays out of the way of what it watches: one thread that sleeps until a collector is due or a
# request comes, a lower priority, and on an RK3588 the small cores (0-3: vision software runs on the
# big ones, 4-7; a board with fewer cores runs it on those it has).

[Unit]
Description=FRC coprocessor agent
After=network.target
# Started again however often it ends: systemd's default gives up after 5 starts in 10 s, and the
# agent ends itself after every push, so a crash loop or a push loop would leave the board without
# it until a reboot.
StartLimitIntervalSec=0

[Service]
Type=simple
# Its own system user (its package makes it, with systemd-sysusers), in systemd-journal so a pack can
# read the journal. Its one privilege, by its package's polkit rule, is powering off or rebooting (the
# built-in actions core.power-off and core.reboot). A pack's commands run as this user, in this
# sandbox: whatever more they need is their installer's to grant, with a drop-in of its own in
# /etc/systemd/system/frc-spotter.service.d/ (SupplementaryGroups=, DeviceAllow=, ReadWritePaths=,
# ProtectHome=read-only) and, for one command, a polkit rule sorting before 99-frc-spotter.rules
# (docs/agent.md, "Giving a pack more"). sudo can't work here: NoNewPrivileges.
User=frc-spotter
Group=frc-spotter
SupplementaryGroups=systemd-journal
# After the robot pushes packs, it exits to read them, and is started again a second later; a panic
# ends it at once, and it's started again the same way.
ExecStart=/usr/lib/frc-spotter/bin/frc-spotter
Restart=always
RestartSec=1
# Stopping it signals the agent alone; whatever its actions were running is killed once it's gone.
# So a run that was going when it stopped comes back lost, rather than racing the agent's exit to
# record a finish (a run's own polite stop is for cancelling it).
KillMode=mixed
Nice=10
AllowedCPUs=0-3
MemoryMax=200M
# Its tasks: the agent's own (one thread, and at most four more while collectors read files) and
# every process its packs run, and theirs, together: at worst eight commands at once (four
# collectors, two actions, two logs), the processes of each, and what they left running. 256 holds
# all that and an action that starts a threaded program (OpenCV starts one per core), while a fork
# bomb in a pack still can't take the board. Sized when the agent was a JVM; docs/agent.md says what
# it measures now.
TasksMax=256
UMask=0077
# It writes nothing but its own /tmp, its actions' runs (/run/frc-spotter, kept across its restarts,
# gone at a reboot), and pushed packs (/var/lib/frc-spotter, made by its tmpfiles.d entry; on a
# board whose root is read-only, an installer makes it writable for pushes to work). It holds no
# capabilities, and talks only to the robot network, link-local addresses, and itself. No
# MemoryDenyWriteExecute (a pack's own program may compile code as it runs: a JVM, Node, a JIT), and
# no ProcSubset=pid (packs read /proc/stat, /proc/uptime, /proc/meminfo, /proc/sys).
RuntimeDirectory=frc-spotter
RuntimeDirectoryPreserve=yes
ReadWritePaths=-/var/lib/frc-spotter
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
SystemCallArchitectures=native
DevicePolicy=closed
# AF_NETLINK is how a program asks the kernel for the computer's addresses (getifaddrs): the agent
# reads its own that way, for its description and to work out the robot controller's.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
IPAddressDeny=any
IPAddressAllow=localhost 10.0.0.0/8 169.254.0.0/16

[Install]
WantedBy=multi-user.target
