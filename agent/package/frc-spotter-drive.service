# The NVMe drive's health for the coprocessor agent (docs/agent.md): run by its timer, as root,
# which reading the drive's SMART log takes, it writes nvme-cli's reports to /run/frc-spotter/ for
# the agent to read. Installed by the agent's package with frc-spotter-drive.timer.

[Unit]
Description=FRC coprocessor agent: the NVMe drive's health

[Service]
Type=oneshot
ExecStart=/usr/lib/frc-spotter/bin/frc-spotter-drive
# /run/frc-spotter: root's, readable by the agent, kept between runs (a oneshot's runtime directory
# goes when it stops, unless preserved).
RuntimeDirectory=frc-spotter
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
UMask=0022
# Its own messages at warning and worse only, and none of systemd's each minute.
LogLevelMax=notice
# It reads the drive and writes its runtime directory, and nothing else.
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateNetwork=yes
NoNewPrivileges=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
