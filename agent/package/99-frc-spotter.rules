// The coprocessor agent's account is refused everything its package's rule (60) doesn't grant:
// rules run in the order of their names, so this one comes after any other.
polkit.addRule(function (action, subject) {
  if (subject.user === "frc-spotter") {
    return polkit.Result.NO;
  }
  return polkit.Result.NOT_HANDLED;
});
