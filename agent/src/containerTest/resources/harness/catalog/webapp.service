# A stand-in for a program with a web API, for the test-only webapp pack: its service, answering
# on 5800 (./webapp, one request at a time).
[Unit]
Description=Web program stand-in

[Service]
ExecStart=/bin/busybox nc -ll -p 5800 -e /opt/stand-ins/webapp
Restart=on-failure

[Install]
WantedBy=multi-user.target
